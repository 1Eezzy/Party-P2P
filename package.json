{
  "name": "party-p2p",
  "version": "1.5.0",
  "description": "Chat de texto e voz P2P estilo party",
  "main": "main.js",
  "scripts": {
    "build:updater": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-updater.ps1",
    "start": "npm run build:updater && electron .",
    "test": "electron tests/smoke.cjs",
    "dist": "npm run build:updater && electron-builder --win",
    "release": "npm run build:updater && electron-builder --win --publish always"
  },
  "dependencies": { "ws": "^8.18.0" },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.partyp2p.app",
    "productName": "Party P2P",
    "extraResources": [{ "from": "build/updater/PartyP2P.Updater.exe", "to": "updater/PartyP2P.Updater.exe" }],
    "win": { "target": ["nsis", "portable"] },
    "publish": [{ "provider": "github", "owner": "1Eezzy", "repo": "Party-P2P", "releaseType": "release" }]
  }
}
